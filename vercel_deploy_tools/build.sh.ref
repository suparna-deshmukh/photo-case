#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

echo "==> $(python3 --version)"

# 1) CPU-only torch first, pinned to the local dev version (avoids CUDA wheels)
python3 -m pip install --no-cache-dir --disable-pip-version-check "torch==2.14.1" \
  --extra-index-url https://download.pytorch.org/whl/cpu

# 2) Remaining pinned app deps (torch line is removed from requirements.txt)
python3 -m pip install --no-cache-dir --disable-pip-version-check -r ../requirements.txt

# 3) Bake the CLIP model into the function dir so the first request does not
#    pay a ~600MB download at runtime.
export HF_HOME="$(pwd)/.hf_cache"
python3 -c "from sentence_transformers import SentenceTransformer; m = SentenceTransformer('clip-ViT-B-32'); print('CLIP baked OK:', type(m).__name__)"
